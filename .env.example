# 로컬에서 시험 삼아 돌려볼 때만 쓰는 예시입니다.
# 실제 값은 GitHub Secrets 와 Vercel 환경변수에 넣으세요. 이 파일에 적고
# 커밋하면 저장소를 보는 사람이 모두 볼 수 있습니다.

# --- 수집 (GitHub Secrets) -------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 발송 (GitHub Secrets) -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# --- 검토 페이지 (GitHub Variables) ----------------------------------------
REVIEW_URL=

# --- 검토 페이지 (Vercel 환경변수) -----------------------------------------
REVIEW_PIN=
SESSION_SECRET=
GH_TOKEN=
GH_REPO=joongyu01/news
GH_BRANCH=main
